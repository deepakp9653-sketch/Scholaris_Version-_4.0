generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model AdmissionRecord {
  @@map("admission_record")
  id                           String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status                       admission_status              @default(DRAFT)
  institutionId String                        @db.Uuid @map("institution_id")
  assignedOperatorId String?                       @db.Uuid @map("assigned_operator_id")
  capCandidateId String?                       @db.Uuid @map("cap_candidate_id")
  createdAt DateTime                      @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime                      @default(now()) @db.Timestamptz(6) @map("updated_at")
  lockedAt DateTime?                     @db.Timestamptz(6) @map("locked_at")
  holdReason String? @map("hold_reason")
  rejectedReason String? @map("rejected_reason")
  operator                    AppUser?                     @relation(fields: [assignedOperatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institution                 Institution                  @relation(fields: [institutionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  capCandidate                CapCandidate?                @relation(fields: [capCandidateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  admittedStudent             AdmittedStudent?
  documentUploads              DocumentUpload[]
  feeRecord                   FeeRecord?
  form1Application            Form1Application?
  form2Checklist              Form2DocumentChecklist?
  form3Eligibility            Form3Eligibility?
  form4Affidavit              Form4AntiRaggingAffidavit?
  form5Library                Form5LibraryMembership?
  printLogs                    PrintLog[]
  studentProfile              StudentProfile?
  verificationLogs             VerificationLog[]
  excelRowNumber               Int?                          @map("excel_row_number")
  excelSyncedAt                DateTime?                     @db.Timestamptz(6) @map("excel_synced_at")
  syncStatus                   String                        @default("DRAFT") @map("sync_status")
  voterRegisteredYn            String?                       @map("voter_registered_yn")
  epicCardYn                   String?                       @map("epic_card_yn")
  epicNumber                   String?                       @map("epic_number")
  excelSyncAudits              ExcelSyncAudit[]

  @@index([institutionId], map: "idx_admission_record_institution")
  @@index([status], map: "idx_admission_record_status")
  @@index([capCandidateId], map: "idx_admission_record_cap_candidate")
}

model AdmittedStudent {
  @@map("admitted_student")
  admissionRecordId String           @id @db.Uuid @map("admission_record_id")
  snapshot            Json
  admittedAt DateTime         @default(now()) @db.Timestamptz(6) @map("admitted_at")
  record    AdmissionRecord @relation(fields: [admissionRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([snapshot], map: "idx_admitted_student_snapshot", type: Gin)
}

model AppUser {
  @@map("app_user")
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  email            String             @unique
  passwordHash     String             @map("password_hash")
  role             user_role_enum     @default(CLERK_OPERATOR)
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @db.Timestamptz(6) @map("created_at")
  assignedRecords  AdmissionRecord[]
  verifiedDocuments DocumentUpload[]
  printLogs        PrintLog[]
  verificationLogs VerificationLog[]
}

model ChecklistItem {
  @@map("checklist_item")
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  form2Id String                   @db.Uuid @map("form2_id")
  srNo Int @map("sr_no")
  documentName String @map("document_name")
  required                 Boolean                  @default(false)
  form2 Form2DocumentChecklist @relation(fields: [form2Id], references: [admissionRecordId], onDelete: Cascade, onUpdate: NoAction)
  upload          DocumentUpload[]

  @@unique([form2Id, srNo])
}

model DocumentUpload {
  @@map("document_upload")
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admissionRecordId String             @db.Uuid @map("admission_record_id")
  checklistItemId String             @db.Uuid @map("checklist_item_id")
  fileRef String @map("file_ref")
  fileType file_type_enum @map("file_type")
  uploadMethod upload_method_enum @map("upload_method")
  status              doc_status_enum    @default(NOT_UPLOADED)
  systemCheckPassed Boolean? @map("system_check_passed")
  systemCheckNotes String? @map("system_check_notes")
  receivedYn Boolean? @map("received_yn")
  verifiedById String?            @db.Uuid @map("verified_by")
  verifiedAt DateTime?          @db.Timestamptz(6) @map("verified_at")
  uploadedAt DateTime           @default(now()) @db.Timestamptz(6) @map("uploaded_at")
  record    AdmissionRecord   @relation(fields: [admissionRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  checklistItem      ChecklistItem     @relation(fields: [checklistItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifiedBy            AppUser?          @relation(fields: [verifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([admissionRecordId], map: "idx_document_upload_record")
  @@index([status], map: "idx_document_upload_status")
}

model EducationalGap {
  @@map("educational_gap")
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admissionRecordId String            @db.Uuid @map("admission_record_id")
  lastExamName String? @map("last_exam_name")
  seatNo String? @map("seat_no")
  monthYearPassing String? @map("month_year_passing")
  percentage          Decimal?          @db.Decimal
  classGrade String? @map("class_grade")
  form3Eligibility   Form3Eligibility @relation(fields: [admissionRecordId], references: [admissionRecordId], onDelete: Cascade, onUpdate: NoAction)
}

model FeeRecord {
  @@map("fee_record")
  admissionRecordId String             @id @db.Uuid @map("admission_record_id")
  totalFeeAmount Decimal            @default(0) @db.Decimal @map("total_fee_amount")
  amountPaid Decimal            @default(0) @db.Decimal @map("amount_paid")
  remainingBalance Decimal?           @default(0) @db.Decimal @map("remaining_balance")
  modeOfPayment payment_mode_enum? @map("mode_of_payment")
  installmentEnabled Boolean            @default(false) @map("installment_enabled")
  feeStatus fee_status_enum    @default(Unpaid) @map("fee_status")
  record    AdmissionRecord   @relation(fields: [admissionRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  installments         Installment[]
}

model Form1Application {
  @@map("form1_application")
  admissionRecordId String                @id @db.Uuid @map("admission_record_id")
  admissionQuota admission_quota_type? @map("admission_quota")
  admissionCategory String? @map("admission_category")
  homeUniversity String? @map("home_university")
  motherTongue String? @map("mother_tongue")
  sscMarksEnglishObtained Decimal?              @db.Decimal @map("ssc_marks_english_obtained")
  sscMarksEnglishOutOf Decimal?              @db.Decimal @map("ssc_marks_english_out_of")
  sscMarksMathsObtained Decimal?              @db.Decimal @map("ssc_marks_maths_obtained")
  sscMarksMathsOutOf Decimal?              @db.Decimal @map("ssc_marks_maths_out_of")
  sscGrandTotalObtained Decimal?              @db.Decimal @map("ssc_grand_total_obtained")
  sscGrandTotalOutOf Decimal?              @db.Decimal @map("ssc_grand_total_out_of")
  sscPercentage Decimal?              @db.Decimal @map("ssc_percentage")
  sscYearOfPassing Int? @map("ssc_year_of_passing")
  hscPhysicsObtained Decimal?              @db.Decimal @map("hsc_physics_obtained")
  hscPhysicsOutOf Decimal?              @db.Decimal @map("hsc_physics_out_of")
  hscChemistryObtained Decimal?              @db.Decimal @map("hsc_chemistry_obtained")
  hscChemistryOutOf Decimal?              @db.Decimal @map("hsc_chemistry_out_of")
  hscMathsObtained Decimal?              @db.Decimal @map("hsc_maths_obtained")
  hscMathsOutOf Decimal?              @db.Decimal @map("hsc_maths_out_of")
  hscPcmTotalObtained Decimal?              @db.Decimal @map("hsc_pcm_total_obtained")
  hscPcmTotalOutOf Decimal?              @db.Decimal @map("hsc_pcm_total_out_of")
  hscGrandTotalObtained Decimal?              @db.Decimal @map("hsc_grand_total_obtained")
  hscGrandTotalOutOf Decimal?              @db.Decimal @map("hsc_grand_total_out_of")
  hscYearOfPassing Int? @map("hsc_year_of_passing")
  cetPhysicsObtained Decimal?              @db.Decimal @map("cet_physics_obtained")
  cetPhysicsOutOf Decimal?              @db.Decimal @map("cet_physics_out_of")
  cetChemistryObtained Decimal?              @db.Decimal @map("cet_chemistry_obtained")
  cetChemistryOutOf Decimal?              @db.Decimal @map("cet_chemistry_out_of")
  cetMathsObtained Decimal?              @db.Decimal @map("cet_maths_obtained")
  cetMathsOutOf Decimal?              @db.Decimal @map("cet_maths_out_of")
  cetPcmTotalObtained Decimal?              @db.Decimal @map("cet_pcm_total_obtained")
  cetPcmTotalOutOf Decimal?              @db.Decimal @map("cet_pcm_total_out_of")
  cetExamSeatNo String? @map("cet_exam_seat_no")
  cetMeritNo String? @map("cet_merit_no")
  aieeeMarks String? @map("aieee_marks")
  diplomaMarksObtained Decimal?              @db.Decimal @map("diploma_marks_obtained")
  diplomaMarksOutOf Decimal?              @db.Decimal @map("diploma_marks_out_of")
  diplomaBranchCourse String? @map("diploma_branch_course")
  diplomaBteEnrollmentNo String? @map("diploma_bte_enrollment_no")
  diplomaYearOfPassing Int? @map("diploma_year_of_passing")
  annualIncomeOfParent Decimal?              @db.Decimal @map("annual_income_of_parent")
  dateField DateTime?             @db.Date @map("date_field")
  placeField String? @map("place_field")
  signatureStudentRef String? @map("signature_student_ref")
  signatureParentRef String? @map("signature_parent_ref")
  officeUseEligibleFor String? @map("office_use_eligible_for")
  officeUseBranch office_branch_type? @map("office_use_branch")
  record           AdmissionRecord      @relation(fields: [admissionRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Form2DocumentChecklist {
  @@map("form2_document_checklist")
  admissionRecordId String               @id @db.Uuid @map("admission_record_id")
  admissionType admission_type_enum? @map("admission_type")
  capId String? @map("cap_id")
  staffSignRef String? @map("staff_sign_ref")
  studentSignRef String? @map("student_sign_ref")
  checklistDate DateTime?            @db.Date @map("checklist_date")
  items      ChecklistItem[]
  record    AdmissionRecord     @relation(fields: [admissionRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Form3Eligibility {
  @@map("form3_eligibility")
  admissionRecordId String               @id @db.Uuid @map("admission_record_id")
  courseName String? @map("course_name")
  courseYear course_year_type? @map("course_year")
  applicantType applicant_type_type? @map("applicant_type")
  nationality              String?
  religion                 String?
  categoryTick category_type? @map("category_tick")
  belongsToReservedYn Boolean? @map("belongs_to_reserved_yn")
  physicallyDisabledYn Boolean? @map("physically_disabled_yn")
  physicallyDisabledType disability_type? @map("physically_disabled_type")
  qualCourseName String? @map("qual_course_name")
  qualDuration String? @map("qual_duration")
  qualUniversity String? @map("qual_university")
  qualCollegeDept String? @map("qual_college_dept")
  qualSeatNo String? @map("qual_seat_no")
  qualMonthYearPassing String? @map("qual_month_year_passing")
  qualPercentage Decimal?             @db.Decimal @map("qual_percentage")
  qualClassGrade String? @map("qual_class_grade")
  minorityYn Boolean? @map("minority_yn")
  minorityLinguistic Boolean? @map("minority_linguistic")
  minorityReligion Boolean? @map("minority_religion")
  signatureCandidateRef String? @map("signature_candidate_ref")
  officeReceiptNo String? @map("office_receipt_no")
  officeDate DateTime?            @db.Date @map("office_date")
  officeEligibleStatus String? @map("office_eligible_status")
  officeAsst String? @map("office_asst")
  officeSrAsst String? @map("office_sr_asst")
  officeOsRegistrarHod String? @map("office_os_registrar_hod")
  educationalGaps          EducationalGap[]
  record         AdmissionRecord     @relation(fields: [admissionRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Form4AntiRaggingAffidavit {
  @@map("form4_anti_ragging_affidavit")
  admissionRecordId String           @id @db.Uuid @map("admission_record_id")
  fullNameWithEnrollmentNo String? @map("full_name_with_enrollment_no")
  sonDaughterOf String? @map("son_daughter_of")
  admittedToInstitution String? @map("admitted_to_institution")
  declaredDay String? @map("declared_day")
  declaredMonth String? @map("declared_month")
  declaredYear String? @map("declared_year")
  signatureDeponentRef String? @map("signature_deponent_ref")
  verifiedAtPlace String? @map("verified_at_place")
  verifiedDay String? @map("verified_day")
  verifiedMonth String? @map("verified_month")
  verifiedYear String? @map("verified_year")
  signatureDeponentVerificationRef String? @map("signature_deponent_verification_ref")
  record                    AdmissionRecord @relation(fields: [admissionRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Form5LibraryMembership {
  @@map("form5_library_membership")
  admissionRecordId String                   @id @db.Uuid @map("admission_record_id")
  yearLevel library_year_level_type? @map("year_level")
  diplomaFyDsy diploma_fy_dsy_type? @map("diploma_fy_dsy")
  localAddress String? @map("local_address")
  localCity String? @map("local_city")
  localPin String? @map("local_pin")
  castCategory category_type? @map("cast_category")
  librarySignatureRef String? @map("library_signature_ref")
  dateField DateTime?                @db.Date @map("date_field")
  adminOfficerAccountantSignRef String? @map("admin_officer_accountant_sign_ref")
  libraryMembershipIdCardNo String? @map("library_membership_id_card_no")
  remark                            String?
  librarianSignRef String? @map("librarian_sign_ref")
  rulesAgreedYn Boolean                  @default(false) @map("rules_agreed_yn")
  rulesAgreedAt DateTime?                @db.Timestamptz(6) @map("rules_agreed_at")
  record                  AdmissionRecord         @relation(fields: [admissionRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Installment {
  @@map("installment")
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeRecordId String            @db.Uuid @map("fee_record_id")
  installmentNo Int @map("installment_no")
  amount          Decimal           @db.Decimal
  modeOfPayment payment_mode_enum @map("mode_of_payment")
  date            DateTime          @db.Date
  remainingAfter Decimal           @db.Decimal @map("remaining_after")
  voided          Boolean           @default(false)
  feeRecord      FeeRecord        @relation(fields: [feeRecordId], references: [admissionRecordId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([feeRecordId, installmentNo])
}

model Institution {
  @@map("institution")
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  address          String?
  phone            String?
  website          String?
  crestAssetRef String? @map("crest_asset_ref")
  createdAt DateTime           @default(now()) @db.Timestamptz(6) @map("created_at")
  admissionRecords AdmissionRecord[]
}

model PrintLog {
  @@map("print_log")
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admissionRecordId String           @db.Uuid @map("admission_record_id")
  printedAt DateTime         @default(now()) @db.Timestamptz(6) @map("printed_at")
  printedById String           @db.Uuid @map("printed_by")
  version             Int
  record    AdmissionRecord @relation(fields: [admissionRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  printedBy            AppUser         @relation(fields: [printedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model StudentProfile {
  @@map("student_profile")
  admissionRecordId String           @id @db.Uuid @map("admission_record_id")
  fullNameSurname String? @map("full_name_surname")
  fullNameFirst String? @map("full_name_first")
  fullNameFather String? @map("full_name_father")
  fatherName String? @map("father_name")
  motherName String? @map("mother_name")
  dateOfBirth DateTime?        @db.Date @map("date_of_birth")
  gender                 gender_type?
  bloodGroup String? @map("blood_group")
  mobileNo String? @map("mobile_no")
  contactTelNo String? @map("contact_tel_no")
  parentsTelNo String? @map("parents_tel_no")
  email                  String?
  religionCaste String? @map("religion_caste")
  category               category_type?
  branchCourse String? @map("branch_course")
  admissionYearStart Int? @map("admission_year_start")
  admissionYearEnd Int? @map("admission_year_end")
  admissionDate DateTime?        @db.Date @map("admission_date")
  correspondenceAddress String? @map("correspondence_address")
  correspondencePin String? @map("correspondence_pin")
  correspondenceTelNo String? @map("correspondence_tel_no")
  permanentAddress String? @map("permanent_address")
  permanentPin String? @map("permanent_pin")
  permanentCity String? @map("permanent_city")
  permanentTelNo String? @map("permanent_tel_no")
  aadharNoEncrypted Bytes? @map("aadhar_no_encrypted")
  panNo String? @map("pan_no")
  photoFileRef String? @map("photo_file_ref")
  admissionReceiptNo String? @map("admission_receipt_no")
  updatedAt DateTime         @default(now()) @db.Timestamptz(6) @map("updated_at")
  record       AdmissionRecord @relation(fields: [admissionRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model VerificationLog {
  @@map("verification_log")
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admissionRecordId String                   @db.Uuid @map("admission_record_id")
  action              verification_action_enum
  actorId String                   @db.Uuid @map("actor_id")
  roleAtTime String @map("role_at_time")
  passwordConfirmed Boolean @map("password_confirmed")
  timestamp           DateTime                 @default(now()) @db.Timestamptz(6)
  notes               String?
  actor            AppUser                 @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  record    AdmissionRecord         @relation(fields: [admissionRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([admissionRecordId], map: "idx_verification_log_record")
}

enum admission_quota_type {
  CAP_CET_AIEEE
  JK
  MGMT
  AGAINST_CAP
}

enum admission_status {
  DRAFT
  FORMS_COMPLETE
  DOCS_IN_PROGRESS
  DOCS_VERIFIED
  FEE_RECORDED
  READY_TO_PRINT
  PRINTED
  PENDING_FINAL_VERIFICATION
  ADMITTED
  ON_HOLD
  REJECTED
}

enum admission_type_enum {
  FE
  DSE
}

enum applicant_type_type {
  Maharashtrian
  Non_Maharashtrian @map("Non-Maharashtrian")
}

enum category_type {
  Open
  OBC
  SBC
  SEBC
  EWS
  DEF
  PH
  Other
  NT1
  NT2
  NT3
  NT_B_ @map("NT(B)")
  NT_C_ @map("NT(C)")
  NT_D_ @map("NT(D)")
  DT_A_ @map("DT(A)")
  VJ
  SC
  ST
}

enum course_year_type {
  st @map("1st")
  nd @map("2nd")
  rd @map("3rd")
  th4 @map("4th")
  th5 @map("5th")
}

enum diploma_fy_dsy_type {
  FY
  DSY
}

enum disability_type {
  P1
  P2
  P3
  P4
  OT
}

enum doc_status_enum {
  NOT_UPLOADED
  UPLOADED_PENDING_REVIEW
  VERIFIED
  REJECTED_REUPLOAD
}

enum fee_status_enum {
  Unpaid
  Partially_Paid
  Fully_Paid
}

enum file_type_enum {
  image
  pdf
}

enum gender_type {
  Male
  Female
  Transgender
}

enum library_year_level_type {
  FE
  SE
  ME
  PhD
}

enum office_branch_type {
  Civil
  Comp
  ETC
  IT
  Mech
  Elect
}

enum payment_mode_enum {
  Cash
  UPI
  Bank_to_Bank
  RTGS
  DD
}

enum upload_method_enum {
  scan
  drag_drop
  browse
}

enum user_role_enum {
  FrontDesk
  VerificationAdmin
  HigherAuthority
  SystemAdmin
  PRINCIPAL
  CLERK_OPERATOR
}

enum verification_action_enum {
  FORMS_SAVE_PASSWORD
  DOC_VERIFIED
  FINAL_VERIFICATION_PASSWORD
  STATUS_CHANGE
  UNLOCK
}

// ─── CAP Round Parser Models ──────────────────────────────────────────────────

model CapInstitute {
  @@map("cap_institute")
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String          @unique
  name        String
  createdAt   DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  batches     CapUploadBatch[]
  departments CapDepartment[]
}

model CapUploadBatch {
  @@map("cap_upload_batch")
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instituteId    String          @db.Uuid @map("institute_id")
  roundLabel     String          @map("round_label")
  publishedOn    DateTime?       @db.Date @map("published_on")
  sourceFilename String          @map("source_filename")
  status         cap_batch_status @default(processing)
  errorMessage   String?         @map("error_message")
  uploadedById   String?         @db.Uuid @map("uploaded_by_id")
  createdAt      DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  institute      CapInstitute    @relation(fields: [instituteId], references: [id], onDelete: NoAction)
  choiceCodes    CapChoiceCode[]

  @@index([instituteId], map: "idx_cap_batch_institute")
}

model CapDepartment {
  @@map("cap_department")
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instituteId String        @db.Uuid @map("institute_id")
  name        String
  institute   CapInstitute  @relation(fields: [instituteId], references: [id], onDelete: NoAction)
  choiceCodes CapChoiceCode[]

  @@unique([instituteId, name])
}

model CapChoiceCode {
  @@map("cap_choice_code")
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId        String        @db.Uuid @map("batch_id")
  departmentId   String        @db.Uuid @map("department_id")
  code           String
  variant        cap_variant   @default(GENERAL)
  statusLabel    String?       @map("status_label")
  sanctionIntake Int           @default(0) @map("sanction_intake")
  capSeats       Int           @default(0) @map("cap_seats")
  msSeats        Int           @default(0) @map("ms_seats")
  minoritySeats  Int           @default(0) @map("minority_seats")
  aiSeats        Int           @default(0) @map("ai_seats")
  instituteSeats Int           @default(0) @map("institute_seats")
  filledSeats    Int           @default(0) @map("filled_seats")
  vacantSeats    Int           @default(0) @map("vacant_seats")
  batch          CapUploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  department     CapDepartment  @relation(fields: [departmentId], references: [id], onDelete: NoAction)
  seatPools      CapSeatPool[]
  candidates     CapCandidate[]

  @@unique([batchId, code])
  @@index([batchId], map: "idx_cap_choice_code_batch")
}

model CapSeatPool {
  @@map("cap_seat_pool")
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  choiceCodeId String       @db.Uuid @map("choice_code_id")
  label        String
  sortOrder    Int          @default(0) @map("sort_order")
  choiceCode   CapChoiceCode @relation(fields: [choiceCodeId], references: [id], onDelete: Cascade)
  candidates   CapCandidate[]
}

model CapCandidate {
  @@map("cap_candidate")
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  choiceCodeId    String        @db.Uuid @map("choice_code_id")
  seatPoolId      String?       @db.Uuid @map("seat_pool_id")
  srNo            Int           @map("sr_no")
  meritNo         Int?          @map("merit_no")
  score           Decimal?      @db.Decimal
  scoreType       cap_score_type? @map("score_type")
  applicationId   String?       @map("application_id")
  candidateName   String        @map("candidate_name")
  gender          cap_gender?   
  category        String?
  seatTypeCode    String?       @map("seat_type_code")
  statusSymbol    String?       @map("status_symbol") @db.Char(1)
  statusLabel     String?       @map("status_label")
  isVacant        Boolean       @default(false) @map("is_vacant")
  createdAt       DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")
  choiceCode      CapChoiceCode  @relation(fields: [choiceCodeId], references: [id], onDelete: Cascade)
  seatPool        CapSeatPool?   @relation(fields: [seatPoolId], references: [id], onDelete: NoAction)
  admissionRecords AdmissionRecord[]

  @@index([choiceCodeId], map: "idx_cap_candidate_choice_code")
  @@index([applicationId], map: "idx_cap_candidate_application_id")
}

enum cap_batch_status {
  processing
  success
  failed
}

enum cap_variant {
  GENERAL
  EWS
  TFWS
}

enum cap_score_type {
  MHT_CET
  JEE_MAIN
}

enum cap_gender {
  M
  F
  O
}

enum AdmissionPhaseCategory {
  GENERAL
  CAP_ROUND_1
  CAP_ROUND_2
  CAP_ROUND_3
  CAP_ROUND_4
  INSTITUTE_LEVEL
}

model AdmissionPhase {
  id            String                  @id @default(cuid())
  academicYear  String                  @map("academic_year")
  srNo          Int                     @map("sr_no")
  category      AdmissionPhaseCategory
  activity      String
  shortLabel    String                  @map("short_label")
  firstDate     DateTime                @map("first_date")
  lastDate      DateTime?               @map("last_date")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@unique([academicYear, srNo])
  @@index([academicYear, firstDate])
  @@map("admission_phase")
}

model DocLibEligibilityFile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @default("default") @map("tenant_id")
  department String
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  checksum   String
  uploadedAt DateTime @default(now()) @db.Timestamptz(6) @map("uploaded_at")
  uploadedBy String   @default("system") @map("uploaded_by")

  @@map("doc_lib_eligibility_file")
}

model DocLibAccessLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @default("default") @map("tenant_id")
  actorId    String   @map("actor_id")
  action     String
  targetFile String?  @map("target_file")
  timestamp  DateTime @default(now()) @db.Timestamptz(6) @map("timestamp")

  @@map("doc_lib_access_log")
}

model AcademicBatch {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicYear     String           @map("academic_year")
  admissionStatus  String           @map("admission_status")
  branchCode       String           @map("branch_code")
  workingExcelPath String           @map("working_excel_path")
  nextFreeRow      Int              @default(15) @map("next_free_row")
  finalizedAt      DateTime?        @db.Timestamptz(6) @map("finalized_at")
  createdAt        DateTime         @default(now()) @db.Timestamptz(6) @map("created_at")
  audits           ExcelSyncAudit[]

  @@unique([academicYear, branchCode, admissionStatus])
  @@map("academic_batch")
}

model ExcelSyncAudit {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId     String          @db.Uuid @map("student_id")
  batchId       String          @db.Uuid @map("batch_id")
  action        String
  detail        Json
  performedById String          @map("performed_by_id")
  performedAt   DateTime        @default(now()) @db.Timestamptz(6) @map("performed_at")
  batch         AcademicBatch   @relation(fields: [batchId], references: [id], onDelete: NoAction)
  record        AdmissionRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("excel_sync_audit")
}


