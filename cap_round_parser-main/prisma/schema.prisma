datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Variant {
  GENERAL
  EWS
  TFWS
}

enum UploadStatus {
  processing
  success
  failed
}

enum ScoreType {
  MHT_CET
  JEE_MAIN
}

enum Gender {
  M
  F
  O
}

model Institute {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  createdAt     DateTime      @default(now()) @map("created_at")
  uploadBatches UploadBatch[]
  departments   Department[]

  @@map("institutes")
}

model Admin {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String        @map("password_hash")
  createdAt     DateTime      @default(now()) @map("created_at")
  uploadBatches UploadBatch[]

  @@map("admins")
}

model UploadBatch {
  id             String       @id @default(uuid())
  instituteId    String       @map("institute_id")
  roundLabel     String       @map("round_label")
  publishedOn    DateTime?    @map("published_on")
  sourceFilename String       @map("source_filename")
  status         UploadStatus @default(processing)
  errorMessage   String?      @map("error_message")
  uploadedBy     String       @map("uploaded_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  institute      Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  admin          Admin        @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  choiceCodes    ChoiceCode[]

  @@map("upload_batches")
}

model Department {
  id          String       @id @default(uuid())
  instituteId String       @map("institute_id")
  name        String
  institute   Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  choiceCodes ChoiceCode[]

  @@unique([instituteId, name])
  @@map("departments")
}

model ChoiceCode {
  id             String      @id @default(uuid())
  batchId        String      @map("batch_id")
  departmentId   String      @map("department_id")
  code           String
  variant        Variant     @default(GENERAL)
  statusLabel    String?     @map("status_label")
  sanctionIntake Int         @default(0) @map("sanction_intake")
  capSeats       Int         @default(0) @map("cap_seats")
  msSeats        Int         @default(0) @map("ms_seats")
  minoritySeats  Int         @default(0) @map("minority_seats")
  aiSeats        Int         @default(0) @map("ai_seats")
  instituteSeats Int         @default(0) @map("institute_seats")
  filledSeats    Int         @default(0) @map("filled_seats")
  vacantSeats    Int         @default(0) @map("vacant_seats")

  batch          UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  department     Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  seatPools      SeatPool[]
  candidates     Candidate[]

  @@unique([batchId, code])
  @@map("choice_codes")
}

model SeatPool {
  id           String      @id @default(uuid())
  choiceCodeId String      @map("choice_code_id")
  label        String
  sortOrder    Int         @default(0) @map("sort_order")

  choiceCode   ChoiceCode  @relation(fields: [choiceCodeId], references: [id], onDelete: Cascade)
  candidates   Candidate[]

  @@map("seat_pools")
}

model Candidate {
  id            String     @id @default(uuid())
  choiceCodeId  String     @map("choice_code_id")
  seatPoolId    String     @map("seat_pool_id")
  srNo          Int        @map("sr_no")
  meritNo       Int?       @map("merit_no")
  score         Float?
  scoreType     ScoreType? @map("score_type")
  applicationId String?    @map("application_id")
  candidateName String     @map("candidate_name")
  gender        Gender?
  category      String?
  seatTypeCode  String     @map("seat_type_code")
  statusSymbol  String?    @map("status_symbol")
  statusLabel   String?    @map("status_label")
  isVacant      Boolean    @default(false) @map("is_vacant")
  createdAt     DateTime   @default(now()) @map("created_at")

  choiceCode    ChoiceCode @relation(fields: [choiceCodeId], references: [id], onDelete: Cascade)
  seatPool      SeatPool   @relation(fields: [seatPoolId], references: [id], onDelete: Cascade)

  @@index([choiceCodeId])
  @@index([applicationId])
  @@map("candidates")
}
